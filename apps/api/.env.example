# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3001

# Platform Database
PLATFORM_DATABASE_URL=postgresql://opsaura:password@localhost:5432/platform_db

# Tenant Databases (base URL — tenant slug is appended per request)
TENANT_DATABASE_BASE_URL=postgresql://opsaura:password@localhost:5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-min-64-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-min-64-chars
JWT_REFRESH_EXPIRY=7d

# Cookies
COOKIE_SECRET=change-me-cookie-secret

# Bcrypt
BCRYPT_ROUNDS=12

# Throttle (requests per second per IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# SMTP (for password reset emails)
SMTP_HOST=smtp.opsaura.io
SMTP_PORT=587
SMTP_USER=system@opsaura.io
SMTP_PASS=
SMTP_FROM=OpsAura <system@opsaura.io>

# Audit queue
AUDIT_QUEUE_NAME=audit-events

# Notification channel config encryption (min 32 chars)
CHANNEL_ENCRYPTION_KEY=change-me-to-a-random-32-char-min-secret
